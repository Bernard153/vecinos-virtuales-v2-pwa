{
  "id": "/",
  "name": "Vecinos Virtuales",
  "short_name": "VV",
  "description": "Red social de barrio para comprar, vender, mejorar y conectar con tu comunidad",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3b82f6",
  "orientation": "portrait-primary",
  "icons": [
  {
    "src": "/images/Vecinos_x192.png",
    "sizes": "192x192",
    "type": "image/png",
    "purpose": "any"
  },
  {
    "src": "/images/Vecinos_x512.png",
    "sizes": "512x512",
    "type": "image/png",
    "purpose": "any"
  }
],
  "categories": ["social", "lifestyle", "shopping"],
  "shortcuts": [
    {
      "name": "Marketplace",
      "short_name": "Comprar",
      "description": "Ver productos disponibles",
      "url": "/?section=marketplace",
      "icons": [{ "src": "/images/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Mapa",
      "short_name": "Mapa",
      "description": "Ver mapa del barrio",
      "url": "/?section=map",
      "icons": [{ "src": "/images/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Mejoras",
      "short_name": "Mejoras",
      "description": "Propuestas del barrio",
      "url": "/?section=improvements",
      "icons": [{ "src": "/images/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Alerta Vigía",
      "short_name": "Vigía",
      "description": "Activar alerta de seguridad",
      "url": "/?alerta=1",
      "icons": [{ "src": "/images/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  },
    "screenshots": [
    {
      "src": "/images/captura-movil.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/images/captura-escritorio.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ]

}
